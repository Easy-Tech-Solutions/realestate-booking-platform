# Docker Compose variable interpolation (root .env — NOT loaded by Django).
# Vite bakes the VITE_* values into the frontend bundle at image build time;
# keep them in sync with frontend/.env. Copy this file to .env and fill in
# real values — never commit the real .env (it's gitignored).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_real_key
VITE_GOOGLE_OAUTH_CLIENT_ID=replace-with-real-client-id.apps.googleusercontent.com

# pgAdmin (docker-compose.yml's pgadmin service)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-unique-password
