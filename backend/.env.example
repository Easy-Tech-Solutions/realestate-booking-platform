DJANGO_SECRET_KEY=replace-with-a-real-random-secret-generate-your-own-never-reuse-this-placeholder
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_REGEXES=

# Auth
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Database
# Use your Neon PostgreSQL connection string here, or fill the POSTGRES_* values below.
DB_ENGINE=postgres
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Email
# Production: set EMAIL_BACKEND=anymail.backends.sendinblue.EmailBackend and supply BREVO_API_KEY
# Development: leave as console backend below
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# SMTP fallback (only used when EMAIL_BACKEND is django.core.mail.backends.smtp.EmailBackend)
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15

# Domain
LOCAL_DOMAIN=localhost:8000
SITE_NAME=Real Estate Booking Platform

# Google OAuth2 (Web client ID from Google Cloud Console — public, not a secret)
GOOGLE_OAUTH_CLIENT_ID=

# Flutterwave (optional)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_KEY=

# MTN Mobile Money — sandbox_mode/sandbox_url/live_url are configured on the
# PaymentGateway row (name='mtn_momo') in Django admin instead, not here.
# COLLECTION_KEY/DISBURSEMENT_KEY are shared across currencies. MTN's
# callback webhooks aren't signed, so there's no webhook secret to set here
# (see payments/gateways/mtn_momo.py). The API user (user_id + api_secret) is
# per-currency — MTN ties it to one specific account ("Account: LRD" or
# "Account: USD" in their partner portal's Configure -> Create API user
# flow). Add more MTN_MOMO_USER_ID_xxx / MTN_MOMO_API_SECRET_xxx pairs here
# if you ever support a third currency.
MTN_MOMO_COLLECTION_KEY=
MTN_MOMO_DISBURSEMENT_KEY=
MTN_MOMO_USER_ID_LRD=
MTN_MOMO_API_SECRET_LRD=
MTN_MOMO_USER_ID_USD=
MTN_MOMO_API_SECRET_USD=

# Orange Money (optional)
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=

# Redis (optional — leave blank to use in-memory channel layer and eager Celery)
REDIS_URL=

# Celery (set to false in production)
CELERY_ALWAYS_EAGER=true

# Security
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# Media files (local disk storage)
MEDIA_ROOT=/opt/homekonet/backend/media
MEDIA_URL=/media/

# Cloudinary (optional; leave blank to use local disk storage)
CLOUDINARY_URL=

# Stripe (required for card payment processing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Push Notifications (VAPID keys — generate with: python manage.py generate_vapid_keys)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Django admin URL (change from default 'admin/' to obscure path in production)
DJANGO_ADMIN_URL=admin/

# Auth cookie settings (required for production cross-origin auth)
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAMESITE=Lax

# Custom CSRF trusted origins (comma-separated, e.g. https://yourdomain.com)
CSRF_TRUSTED_ORIGINS=
